# Local Development Environment Variables

# Django Settings
DEBUG=True
SECRET_KEY=your-local-secret-key-here-change-this
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.1.5

# Database Configuration (PostgreSQL for local development - using katende user)
